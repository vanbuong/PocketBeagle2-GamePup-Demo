# SPDX-License-Identifier: GPL-2.0-only
# Target board image for CI / cross builds.
#
# PocketBeagle 2 Debian 13.7 2026-09-20 IoT (v6.18.x-k3)
# https://www.beagleboard.org/distros/pocketbeagle-2-debian-13-7-2026-09-20-iot-v6-18-x-k3

TARGET_IMAGE_NAME='PocketBeagle 2 Debian 13.7 2026-09-20 IoT (v6.18.x-k3)'
TARGET_IMAGE_FILE=pocketbeagle2-debian-13.7-iot-v6.18-k3-arm64-2026-09-20-10gb.img.xz
TARGET_IMAGE_URL=https://files.beagle.cc/file/beagleboard-public-2021/images/${TARGET_IMAGE_FILE}
TARGET_IMAGE_SHA256=9c74bb2b09cf4292f4674201c2a20f92aef3cd9013dba0667b22bb750c03cd07

# BeagleBoard.org apt repo used by that image family.
BB_REPO_URL=https://repos.rcn-ee.com/debian-trixie-arm64
BB_REPO_DIST=trixie
BB_HEADERS_META=bbb.io-headers-6.18-k3

# Fallback when the meta package cannot be resolved online.
BB_HEADERS_PACKAGE_FALLBACK=linux-headers-6.18.52-arm64-k3-r56
BB_HEADERS_VERSION_FALLBACK=6.18.52-arm64-k3-r56

# Pinned libretro core commits (must match emulator/install-*.sh).
NESTOPIA_COMMIT=b0fd87dd07e3c52903435d302b04e5e97796f127
GAMBATTE_COMMIT=9b3b5e3cc18ec92f460d37dd551eaf90c55bfcea
PRBOOM_COMMIT=b4dfa039e4192dd392a2ed49864bed7c65f171e7
N64_COMMIT=98c1b0d877542b01314b3b04272282ba223b65b3
