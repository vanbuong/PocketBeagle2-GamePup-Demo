    KEY_ESC: ("X", 222, 52, 36, 18),
    KEY_P: ("Y", 182, 76, 36, 18),
    KEY_TAB: ("A", 262, 76, 36, 18),
    KEY_ENTER: ("B", 222, 100, 36, 18),
    KEY_5: ("SEL", 60, 138, 64, 18),
    KEY_1: ("START", 180, 138, 80, 18),
}

running = True


def stop_handler(_signum, _frame):
    global running
    running = False


def fill_rect(canvas: array, x: int, y: int, width: int, height: int, color: int):
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(WIDTH, x + width), min(HEIGHT, y + height)
    row = array("I", [color]) * max(0, x1 - x0)
    for target_y in range(y0, y1):
        canvas[target_y * WIDTH + x0:target_y * WIDTH + x1] = row


def draw_text(canvas: array, x: int, y: int, text: str, color: int, scale: int = 1):
    cursor = x
    for character in text.upper():
        glyph = FONT.get(character, FONT["?"])
        for glyph_y, bits in enumerate(glyph):
            for glyph_x, bit in enumerate(bits):
                if bit == "1":
                    fill_rect(canvas, cursor + glyph_x * scale,
                              y + glyph_y * scale, scale, scale, color)
        cursor += 6 * scale


def centered_text(canvas: array, y: int, text: str, color: int, scale: int = 1):
    width = (len(text) * 6 - 1) * scale
    draw_text(canvas, (WIDTH - width) // 2, y, text, color, scale)


def write_led(path: Path, enabled: bool):
    try:
        path.write_text("1\n" if enabled else "0\n", encoding="ascii")
    except OSError as error:
        print(f"Unable to control {path}: {error}", file=sys.stderr)


def write_tone(buzzer_fd: int, frequency: int):
    try:
        os.write(buzzer_fd, EVENT.pack(0, 0, EV_SND, SND_TONE, frequency))
    except OSError as error:
        print(f"Unable to control buzzer: {error}", file=sys.stderr)


def brightness_value() -> int:
    path = backlight_path()
    if path is None:
        return 11
    try:
        return int(path.read_text(encoding="ascii").strip())
    except (OSError, ValueError):
        return 11


def adjust_brightness(direction: int) -> int:
    level = max(0, min(11, brightness_value() + direction))
    path = backlight_path()
    if path is None:
        print("No backlight sysfs node found.", file=sys.stderr)
        return level
    try:
        path.write_text(f"{level}\n", encoding="ascii")
    except OSError as error:
        print(f"Unable to control backlight: {error}", file=sys.stderr)
    return level


def draw_color_test(framebuffer: int, pattern: int):
    colors = (RED, GREEN, BLUE, WHITE, BLACK)
    if pattern <= len(colors):
        canvas = array("I", [colors[pattern - 1]]) * (WIDTH * HEIGHT)
        label_color = BLACK if colors[pattern - 1] == WHITE else WHITE
        centered_text(canvas, 220, "START NEXT", label_color)
    else:
        canvas = array("I", [BLACK]) * (WIDTH * HEIGHT)
        bars = (WHITE, YELLOW, CYAN, GREEN, MAGENTA, RED, BLUE, BLACK)
        bar_width = WIDTH // len(bars)
        for index, color in enumerate(bars):
            fill_rect(canvas, index * bar_width, 0,
                      WIDTH if index == len(bars) - 1 else bar_width,
                      HEIGHT, color)
        fill_rect(canvas, (WIDTH - 96) // 2, 216, 96, 14, BLACK)
        centered_text(canvas, 220, "START UI", WHITE)
    present_canvas(framebuffer, canvas)


def draw_ui(framebuffer: int, pressed: set[int], tested: set[int],
            frequency: int, brightness: int):
    canvas = array("I", [BLACK]) * (WIDTH * HEIGHT)
    centered_text(canvas, 3, "HARDWARE TEST", GREEN)
    centered_text(canvas, 14, f"BUTTONS {len(tested)}/10", YELLOW)
    fill_rect(canvas, 3, 27, WIDTH - 6, 1, DARK_GREEN)

    for code, (label, x, y, width, height) in BUTTONS.items():
        if code in pressed:
            color, text_color = YELLOW, BLACK
        elif code in tested:
            color, text_color = DARK_GREEN, GREEN
        else:
            color, text_color = BLUE, WHITE
        fill_rect(canvas, x, y, width, height, color)
        text_width = len(label) * 6 - 1
        draw_text(canvas, x + (width - text_width) // 2, y + 2,
                  label, text_color)

    draw_text(canvas, 16, 170, "X LEFT EYE", GRAY)
    draw_text(canvas, 160, 170, "Y RIGHT EYE", GRAY)
    draw_text(canvas, 16, 184, "A BOTH EYES", GRAY)
    draw_text(canvas, 160, 184, "B TONE", GRAY)
    draw_text(canvas, 16, 198, f"UP/DN {frequency}HZ", WHITE)
    draw_text(canvas, 160, 198, f"LT/RT LIGHT {brightness}/11", WHITE)
    centered_text(canvas, 220, "ST COLOR  SEL+ST EXIT", GREEN)
    present_canvas(framebuffer, canvas)


def outputs_off(buzzer_fd: int):
    write_led(LEFT_LED, False)
    write_led(RIGHT_LED, False)
    write_tone(buzzer_fd, 0)


def startup_self_test(buzzer_fd: int):
    for left, right in ((True, False), (False, True), (True, True)):
        write_led(LEFT_LED, left)
        write_led(RIGHT_LED, right)
        time.sleep(0.12)
    outputs_off(buzzer_fd)
    write_tone(buzzer_fd, 880)
    time.sleep(0.14)
    write_tone(buzzer_fd, 0)


def keys_down(input_fd: int) -> set[int]:
    key_bits = bytearray(96)
    eviocgkey = (2 << 30) | (len(key_bits) << 16) | (ord("E") << 8) | 0x18
    fcntl.ioctl(input_fd, eviocgkey, key_bits, True)
    return {code for code in BUTTONS
            if key_bits[code // 8] & (1 << (code % 8))}


def resolve_buzzer_path():
    for candidate in BUZZER_CANDIDATES:
        if os.path.exists(candidate):
            return candidate
    by_path = Path("/dev/input/by-path")
    if by_path.is_dir():
        for pattern in ("*buzzer*", "*pwm-beeper*", "*pwm_beeper*"):
            matches = sorted(by_path.glob(pattern))
            if matches:
                return str(matches[0])
    for name_path in Path("/sys/class/input").glob("event*/device/name"):
        try:
            name = name_path.read_text(encoding="ascii").strip()
        except OSError:
            continue
        lowered = name.casefold()
        if name in ("gamepup-buzzer", "pwm-beeper") or "buzzer" in lowered \
                or "beeper" in lowered:
            return f"/dev/input/{name_path.parent.parent.name}"
    return None


def run_test(self_test_only: bool = False) -> int:
    grant_backlight_access()
    framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
    buzzer_path = resolve_buzzer_path()
    if not buzzer_path:
        print("PWM buzzer input device not found. Check overlay:", file=sys.stderr)
        print("  ls /proc/device-tree/gamepup-buzzer", file=sys.stderr)
        print("  ls /sys/bus/platform/devices/ | grep -iE 'buzzer|beeper|epwm|pwm'",
              file=sys.stderr)
        print("  grep -iE 'beeper|buzzer|epwm2|23020000' /var/log/dmesg dmesg 2>/dev/null | tail",
              file=sys.stderr)
        return 1
    print(f"Buzzer device: {buzzer_path}", file=sys.stderr)
    buzzer_fd = os.open(buzzer_path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
    input_fd = -1
    original_brightness = brightness_value()
    try:
        startup_self_test(buzzer_fd)
        if self_test_only:
            print("LED and buzzer output self-test completed.")
            return 0

        input_fd = os.open(INPUT, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        try:
            fcntl.ioctl(input_fd, EVIOCGRAB, 1)
        except OSError as error:
            print(f"Unable to grab buttons: {error}", file=sys.stderr)
        pressed: set[int] = set()
        tested: set[int] = set()
        frequency = 880
        brightness = original_brightness
        pattern = 0
        exit_started: float | None = None
        draw_ui(framebuffer, pressed, tested, frequency, brightness)

        while running:
            readable, _, _ = select.select([input_fd], [], [], 0.04)
            redraw = False
            if readable:
                data = os.read(input_fd, EVENT.size * 32)
                for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _seconds, _micros, event_type, code, value = EVENT.unpack_from(
                        data, offset)
                    if event_type != EV_KEY or code not in BUTTONS:
                        continue
                    if value:
                        pressed.add(code)
                        tested.add(code)
                    else:
                        pressed.discard(code)
                    if value == 1:
                        if code == KEY_UP:
                            frequency = min(2000, frequency + 100)
                        elif code == KEY_DOWN:
                            frequency = max(200, frequency - 100)
                        elif code == KEY_LEFT:
                            brightness = adjust_brightness(-1)
                        elif code == KEY_RIGHT:
                            brightness = adjust_brightness(1)
                        elif code == KEY_1 and KEY_5 not in pressed:
                            pattern = (pattern + 1) % 7
                    redraw = True

            write_led(LEFT_LED, KEY_ESC in pressed or KEY_TAB in pressed)
            write_led(RIGHT_LED, KEY_P in pressed or KEY_TAB in pressed)
            write_tone(buzzer_fd, frequency if KEY_ENTER in pressed else 0)

            if KEY_1 in pressed and KEY_5 in pressed:
                if exit_started is None:
                    exit_started = time.monotonic()
                elif time.monotonic() - exit_started >= 1.0:
                    break
            else:
                exit_started = None

            if redraw:
                if pattern:
                    draw_color_test(framebuffer, pattern)
                else:
                    draw_ui(framebuffer, pressed, tested, frequency, brightness)
        return 0
    finally:
        outputs_off(buzzer_fd)
        try:
            path = backlight_path()
            if path is not None:
                path.write_text(f"{original_brightness}\n", encoding="ascii")
        except OSError:
            pass
        if input_fd >= 0:
            os.close(input_fd)
        os.close(buzzer_fd)
        os.close(framebuffer)


def main() -> int:
    try:
        return run_test(len(sys.argv) > 1 and sys.argv[1] == "--self-test")
    except OSError as error:
        print(f"Hardware test unavailable: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    signal.signal(signal.SIGINT, stop_handler)
    signal.signal(signal.SIGTERM, stop_handler)
    raise SystemExit(main())
