# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=GamePup second-screen system status display (ST7789 via framebuffer, or SH1106 OLED)
# No Wants=dev-i2c-2.device: with the Tang Nano 9K display there is no I2C OLED, and a Wants=
# on a device that never appears would delay start-up. Restart=on-failure covers a late device.
After=dev-i2c-2.device

[Service]
Type=simple
ExecStart=/usr/local/bin/gamepup-oled-status
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5
# auto: the 240x135 ST7789 framebuffer if present (GAMEPUP_OLED_FB=/dev/fbN to force one),
# otherwise the SH1106 on I2C. Set fb or i2c to pin it.
Environment=GAMEPUP_OLED_BACKEND=auto
Environment=GAMEPUP_OLED_I2C=/dev/i2c-2
Environment=GAMEPUP_OLED_ADDR=0x3c

[Install]
WantedBy=multi-user.target
