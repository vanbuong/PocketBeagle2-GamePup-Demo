# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=GamePup SH1106 OLED system status display
After=dev-i2c-2.device
Wants=dev-i2c-2.device

[Service]
Type=simple
ExecStart=/usr/local/bin/gamepup-oled-status
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5
Environment=GAMEPUP_OLED_I2C=/dev/i2c-2
Environment=GAMEPUP_OLED_ADDR=0x3c

[Install]
WantedBy=multi-user.target
