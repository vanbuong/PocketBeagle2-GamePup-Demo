[Unit]
Description=GamePup game selection menu
After=multi-user.target

[Service]
Type=simple
User=beagle
Group=beagle
SupplementaryGroups=video render input
RuntimeDirectory=gamepup
RuntimeDirectoryMode=0755
ExecStartPre=+/usr/local/libexec/gamepup-fbcon detach
ExecStartPre=+/usr/local/libexec/gamepup-backlight-permissions grant
ExecStart=/usr/local/bin/gamepup-menu
ExecStopPost=+/usr/local/libexec/gamepup-backlight-permissions revoke
ExecStopPost=+/usr/local/libexec/gamepup-fbcon attach
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
