"""Voice memo recorder/player for GamePup MAX98357 + INMP441 I2S audio."""

from array import array
from datetime import datetime
import fcntl
import os
from pathlib import Path
import re
import select
import signal
import struct
import subprocess
import sys
import time


WIDTH = 320
HEIGHT = 240
FRAMEBUFFER = "/dev/fb0"
INPUT = "/dev/input/by-path/platform-gamepup-buttons-event"
INPUT_FALLBACK = "/dev/input/event0"
MEMO_DIR = Path("/opt/gamepup/voice-memos")
SAMPLE_RATE = 48000
CHANNELS = 2
SAMPLE_FORMAT = "S32_LE"
BYTES_PER_FRAME = CHANNELS * 4
MAX_RECORD_SECONDS = 120
EVENT = struct.Struct("@llHHi")
EV_KEY = 1
EVIOCGRAB = 0x40044590
FBIOGET_VSCREENINFO = 0x4600
FBIOGET_FSCREENINFO = 0x4602

KEY_1 = 2
KEY_5 = 6
KEY_TAB = 15
KEY_ENTER = 28
KEY_UP = 103
KEY_DOWN = 108

BLACK = 0x000000
WHITE = 0xF4F4E8
GREEN = 0x42D65C
DARK_GREEN = 0x123D22
YELLOW = 0xF4D35E
BLUE = 0x174A70
GRAY = 0x708078
RED = 0xE85D5D

