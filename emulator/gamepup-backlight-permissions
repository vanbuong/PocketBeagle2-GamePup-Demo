#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Grant the GamePup UI temporary access to the backlight and eye LEDs.

set -eu

resolve_backlight() {
	for candidate in \
		/sys/class/backlight/backlight-gamepup/brightness \
		/sys/class/backlight/lcd-backlight/brightness
	do
		if [ -e "$candidate" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	for candidate in /sys/class/backlight/*/brightness; do
		if [ -e "$candidate" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

backlight=
if ! backlight=$(resolve_backlight); then
	backlight=
fi
left_eye=/sys/class/leds/gamepup:left-eye/brightness
right_eye=/sys/class/leds/gamepup:right-eye/brightness

case "${1:-}" in
	grant)
		if [ -n "$backlight" ]; then
			chgrp video "$backlight"
			chmod 0664 "$backlight"
		else
			echo "gamepup-backlight-permissions: no backlight sysfs node found" >&2
		fi
		for brightness in "$left_eye" "$right_eye"; do
			[ ! -e "$brightness" ] || chgrp input "$brightness"
			[ ! -e "$brightness" ] || chmod 0664 "$brightness"
		done
		;;
	revoke)
		if [ -n "$backlight" ]; then
			chgrp root "$backlight" 2>/dev/null || true
			chmod 0644 "$backlight" 2>/dev/null || true
		fi
		for brightness in "$left_eye" "$right_eye"; do
			[ ! -e "$brightness" ] || chgrp root "$brightness"
			[ ! -e "$brightness" ] || chmod 0644 "$brightness"
		done
		;;
	*)
		echo "usage: $0 grant|revoke" >&2
		exit 2
		;;
esac
