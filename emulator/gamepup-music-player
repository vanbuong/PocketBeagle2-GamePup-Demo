def fill_rect(canvas, x, y, width, height, color):
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(WIDTH, x + width), min(HEIGHT, y + height)
    row = array("I", [color]) * max(0, x1 - x0)
    for target_y in range(y0, y1):
        canvas[target_y * WIDTH + x0:target_y * WIDTH + x1] = row


def draw_text(canvas, x, y, text, color, scale=1):
    cursor = x
    for character in text.upper():
        glyph = FONT.get(character, FONT["?"])
        for glyph_y, bits in enumerate(glyph):
            for glyph_x, bit in enumerate(bits):
                if bit == "1":
                    fill_rect(canvas, cursor + glyph_x * scale,
                              y + glyph_y * scale, scale, scale, color)
        cursor += 6 * scale


def read_fb_info(framebuffer):
    global _fb_info
    if _fb_info is not None:
        return _fb_info
    var = array("B", [0]) * 160
    fix = array("B", [0]) * 128
    fcntl.ioctl(framebuffer, FBIOGET_VSCREENINFO, var, True)
    fcntl.ioctl(framebuffer, FBIOGET_FSCREENINFO, fix, True)
    xres = int.from_bytes(var[0:4], "little")
    yres = int.from_bytes(var[4:8], "little")
    bpp = int.from_bytes(var[24:28], "little")
    try:
        stride = int(Path("/sys/class/graphics/fb0/stride").read_text().strip())
    except (OSError, ValueError):
        stride = xres * (bpp // 8)
    if bpp not in (16, 32):
        raise OSError(f"Expected 16- or 32-bit framebuffer, got {bpp} bpp")
    if (xres, yres) not in ((WIDTH, HEIGHT), (HEIGHT, WIDTH)):
        raise OSError(f"Unsupported framebuffer {xres}x{yres}")
    _fb_info = {"width": xres, "height": yres, "stride": stride, "bpp": bpp}
    return _fb_info


def _rgb565(color: int) -> int:
    red = (color >> 16) & 0xff
    green = (color >> 8) & 0xff
    blue = color & 0xff
    return ((red >> 3) << 11) | ((green >> 2) << 5) | (blue >> 3)


def present_canvas(framebuffer, canvas):
    """Blit RGB888 canvas to fb. Fast path avoids per-pixel Python calls."""
    info = read_fb_info(framebuffer)
    stride = info["stride"]
    height = info["height"]
    width = info["width"]
    bpp = info["bpp"]

    if bpp == 16:
        # One Python pass into a packed RGB565 buffer (array 'H' is native).
        pixels = array("H", (_rgb565(color) for color in canvas))
        if width == WIDTH and height == HEIGHT:
            packed = pixels.tobytes()
            if stride == WIDTH * 2:
                os.pwrite(framebuffer, packed, 0)
                return
            frame = bytearray(stride * HEIGHT)
            row = WIDTH * 2
            for y in range(HEIGHT):
                src = y * row
                dst = y * stride
                frame[dst:dst + row] = packed[src:src + row]
            os.pwrite(framebuffer, frame, 0)
            return
        if width == HEIGHT and height == WIDTH:
            frame = bytearray(stride * height)
            for y in range(HEIGHT):
                row_base = y * WIDTH
                for x in range(WIDTH):
                    dst_x = y
                    dst_y = WIDTH - 1 - x
                    offset = dst_y * stride + dst_x * 2
                    frame[offset:offset + 2] = int(pixels[row_base + x]).to_bytes(
                        2, "little")
            os.pwrite(framebuffer, frame, 0)
            return

    # 32-bpp or unexpected geometry fallback.
    frame = bytearray(stride * height)
    if width == WIDTH and height == HEIGHT:
        for y in range(HEIGHT):
            for x in range(WIDTH):
                color = int(canvas[y * WIDTH + x])
                offset = y * stride + x * 4
                frame[offset:offset + 4] = int(color).to_bytes(4, "little")
    else:
        for y in range(HEIGHT):
            for x in range(WIDTH):
                color = int(canvas[y * WIDTH + x])
                dst_x, dst_y = y, WIDTH - 1 - x
                offset = dst_y * stride + dst_x * 4
                frame[offset:offset + 4] = int(color).to_bytes(4, "little")
    os.pwrite(framebuffer, frame, 0)


def open_buttons():
    for path in (INPUT, INPUT_FALLBACK):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        except OSError:
            continue
        try:
            fcntl.ioctl(fd, EVIOCGRAB, 1)
        except OSError as error:
            print(f"EVIOCGRAB {path}: {error}", file=sys.stderr)
        return fd
    raise OSError("No GamePup button input device found")


def alsa_device():
    env = os.environ.get("GAMEPUP_ALSA_DEVICE", "").strip()
    if env:
        return env
    try:
        listing = subprocess.check_output(
            ["aplay", "-l"], text=True, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError):
        return "default"
    for line in listing.splitlines():
        if re.search(r"GamePup|MAX98357|I2S", line, re.IGNORECASE):
            match = re.search(r"card (\d+):", line)
            if match:
                return f"plughw:{match.group(1)},0"
    return "default"


def resolve_mpv_paths():
    """Pick a writable dir for the mpv IPC socket (buongvv may not own /run/gamepup)."""
    candidates = []
    xdg = os.environ.get("XDG_RUNTIME_DIR", "").strip()
    if xdg:
        candidates.append(Path(xdg))
    candidates.extend((
        Path(f"/run/user/{os.getuid()}"),
        Path("/run/gamepup"),
        Path("/tmp"),
    ))
    for root in candidates:
        try:
            root.mkdir(parents=True, exist_ok=True)
            probe = root / f".gamepup-mpv-write-{os.getpid()}"
            probe.write_text("ok", encoding="ascii")
            probe.unlink()
        except OSError:
            continue
        return root / "gamepup-mpv-music.sock", root / "gamepup-mpv-music.log"
    return Path("/tmp/gamepup-mpv-music.sock"), Path("/tmp/gamepup-mpv-music.log")


def ensure_music_root():
    try:
        MUSIC_ROOT.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        raise RuntimeError(
            f"Cannot create {MUSIC_ROOT}: {error}. "
            f"Run: sudo chown -R $(id -un) /opt/gamepup") from error
    readme = MUSIC_ROOT / "README.txt"
    if not readme.exists():
        try:
            readme.write_text(
                "Place music files here (mp3, ogg, flac, wav, m4a, aac, opus).\n"
                "Subfolders are supported in the GamePup music player.\n",
                encoding="utf-8")
        except OSError:
            pass


def drain_keys(input_fd, settle_s=0.35):
    """Drop leftover A/B presses from the parent menu so we do not exit/play immediately."""
    deadline = time.monotonic() + settle_s
    while time.monotonic() < deadline:
        readable, _, _ = select.select([input_fd], [], [], 0.05)
        if not readable:
            continue
        try:
            os.read(input_fd, EVENT.size * 64)
        except OSError:
            break


def draw_message(framebuffer, title, line1, line2=""):
    canvas = array("I", [BLACK]) * (WIDTH * HEIGHT)
    draw_chrome(canvas, title, line1[:48])
    if line2:
        draw_text(canvas, 8, 48, line2[:48], WHITE)
    present_canvas(framebuffer, canvas)


def is_audio(path: Path) -> bool:
    return path.is_file() and path.suffix.casefold() in AUDIO_EXTENSIONS


def list_entries(directory: Path):
    try:
        children = list(directory.iterdir())
    except OSError:
        return []
    dirs = sorted(
        [path for path in children if path.is_dir() and not path.name.startswith(".")],
        key=lambda path: path.name.casefold())
    files = sorted(
        [path for path in children if is_audio(path)],
        key=lambda path: path.name.casefold())
    return dirs + files


def audio_files_in(directory: Path):
    return [path for path in list_entries(directory) if is_audio(path)]


def format_time(seconds):
    if seconds is None or seconds < 0:
        return "--:--"
    total = int(seconds)
    return f"{total // 60}:{total % 60:02d}"


def relative_label(path: Path, cwd: Path) -> str:
    if path.is_dir():
        return f"[{path.name}]/"[:46]
    try:
        rel = path.relative_to(cwd)
    except ValueError:
        rel = path.name
    return str(rel)[:46]


def wait_key(input_fd, timeout=0.1):
    readable, _, _ = select.select([input_fd], [], [], timeout)
    if not readable:
        return None
    data = os.read(input_fd, EVENT.size * 32)
    pressed = None
    for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
        _seconds, _micros, event_type, code, value = EVENT.unpack_from(data, offset)
        if event_type == EV_KEY and value == 1:
            pressed = code
    return pressed


class MpvPlayer:
    def __init__(self, device: str):
        self.device = device
        self.process = None
        self.playlist = []
        self.index = -1
        self.last_error = ""

    def _socket_path(self) -> Path:
        global MPV_SOCKET, MPV_LOG
        MPV_SOCKET, MPV_LOG = resolve_mpv_paths()
        if MPV_SOCKET.exists():
            try:
                MPV_SOCKET.unlink()
            except OSError:
                pass
        return MPV_SOCKET

    def _audio_device_candidates(self):
        raw = self.device.strip() or "default"
        if raw.startswith("alsa/"):
            raw = raw[5:]
        # Prefer bare ALSA names; mpv 0.40 accepts plughw:0,0 without alsa/ prefix.
        candidates = []
        for value in (raw, f"alsa/{raw}", "default", "alsa/default"):
            if value and value not in candidates:
                candidates.append(value)
        return candidates

    def start(self):
        if self.process and self.process.poll() is None:
            return
        if not shutil_which("mpv"):
            raise RuntimeError("mpv binary not found in PATH")

        errors = []
        for audio_device in self._audio_device_candidates():
            socket_path = self._socket_path()
            log_path = MPV_LOG
            command = [
                "mpv",
                "--no-config",
                "--idle=yes",
                "--vo=null",
                "--no-video",
                "--force-window=no",
                "--really-quiet",
                "--no-terminal",
                "--no-input-default-bindings",
                "--keep-open=yes",
                "--ao=alsa",
                f"--audio-device={audio_device}",
                f"--input-ipc-server={socket_path}",
                f"--log-file={log_path}",
            ]
            try:
                self.process = subprocess.Popen(
                    command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as error:
                raise RuntimeError(f"mpv unavailable: {error}") from error

            deadline = time.monotonic() + 4.0
            while time.monotonic() < deadline:
                if socket_path.exists():
                    # Confirm IPC answers before claiming success.
                    if self.get_property("idle-active") is not None or \
                            self.command("get_property", "volume") is not None:
                        self.device = audio_device.removeprefix("alsa/")
                        self.last_error = ""
                        print(f"mpv ready ao={self.device} ipc={socket_path}",
                              file=sys.stderr)
                        return
                if self.process.poll() is not None:
                    break
                time.sleep(0.05)

            detail = ""
            try:
                detail = log_path.read_text(encoding="utf-8", errors="replace").strip()
            except OSError:
                pass
            # Prefer the tail — mpv logs are verbose.
            if detail:
                detail = detail[-400:]
            rc = self.process.poll() if self.process else None
            self.stop()
            errors.append(
                f"audio-device={audio_device} rc={rc}"
                + (f": {detail}" if detail else ""))

        self.last_error = " | ".join(errors) if errors else "unknown"
        raise RuntimeError(
            "mpv IPC socket did not appear. " + self.last_error)

    def stop(self):
        if self.process and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=2)
            except subprocess.TimeoutExpired:
                self.process.kill()
                self.process.wait(timeout=1)
        self.process = None
        self.playlist = []
        self.index = -1
        try:
            MPV_SOCKET.unlink(missing_ok=True)
        except OSError:
            pass

    def _rpc(self, command, timeout=0.4):
        if not MPV_SOCKET.exists():
            return None
        payload = (json.dumps({"command": command}) + "\n").encode("utf-8")
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(timeout)
                sock.connect(str(MPV_SOCKET))
                sock.sendall(payload)
                chunks = []
                while True:
                    try:
                        data = sock.recv(4096)
                    except socket.timeout:
                        break
                    if not data:
                        break
                    chunks.append(data)
                    if b"\n" in data:
                        break
        except OSError:
            return None
        if not chunks:
            return None
        line = b"".join(chunks).split(b"\n", 1)[0]
        try:
            return json.loads(line.decode("utf-8", "replace"))
        except json.JSONDecodeError:
            return None

    def command(self, *args):
        return self._rpc(list(args))

    def get_property(self, name):
        response = self.command("get_property", name)
        if not response or response.get("error") not in (None, "success"):
            return None
        return response.get("data")

    def active(self):
        return self.process is not None and self.process.poll() is None

    def play_list(self, tracks: list[Path], start_index: int = 0):
        if not tracks:
            return False
        self.start()
        self.playlist = list(tracks)
        self.index = max(0, min(start_index, len(tracks) - 1))
        self.command("loadfile", str(self.playlist[0]), "replace")
        for track in self.playlist[1:]:
            self.command("loadfile", str(track), "append")
        self.command("playlist-play-index", self.index)
        self.command("set_property", "volume", load_saved_volume())
        self.command("set_property", "pause", False)
        return True

    def toggle_pause(self):
        self.command("cycle", "pause")

    def seek(self, seconds: int):
        self.command("seek", seconds, "relative")

    def volume(self):
        value = self.get_property("volume")
        if isinstance(value, (int, float)):
            return int(round(value))
        return None

    def set_volume(self, level: int):
        level = max(VOLUME_MIN, min(VOLUME_MAX, int(level)))
        self.command("set_property", "volume", level)
        try:
            VOLUME_FILE.parent.mkdir(parents=True, exist_ok=True)
            VOLUME_FILE.write_text(f"{level}\n", encoding="utf-8")
        except OSError:
            pass
        return level

    def adjust_volume(self, delta: int):
        current = self.volume()
        if current is None:
            current = load_saved_volume()
        return self.set_volume(current + delta)

    def next_track(self):
        if not self.playlist:
            return
        if self.index + 1 < len(self.playlist):
            self.index += 1
            self.command("playlist-next", "weak")
        else:
            self.command("playlist-play-index", self.index)

    def prev_track(self):
        if not self.playlist:
            return
        position = self.get_property("time-pos") or 0
        if isinstance(position, (int, float)) and position > 3 and self.index >= 0:
            self.command("seek", 0, "absolute")
            return
        if self.index > 0:
            self.index -= 1
            self.command("playlist-prev", "weak")
        else:
            self.command("seek", 0, "absolute")

    def stop_playback(self):
        self.command("stop")
        self.playlist = []
        self.index = -1

    def sync_index(self):
        value = self.get_property("playlist-pos")
        if isinstance(value, int) and 0 <= value < len(self.playlist):
            self.index = value

    def status(self):
        if not self.active():
            path = self.playlist[self.index] if 0 <= self.index < len(self.playlist) \
                else None
            return {
                "playing": False,
                "paused": False,
                "position": 0,
                "duration": 0,
                "path": path,
                "index": self.index,
                "count": len(self.playlist),
                "volume": load_saved_volume(),
            }
        self.sync_index()
        paused = bool(self.get_property("pause"))
        position = self.get_property("time-pos")
        duration = self.get_property("duration")
        path = None
        if 0 <= self.index < len(self.playlist):
            path = self.playlist[self.index]
        else:
            media = self.get_property("path")
            if isinstance(media, str):
                path = Path(media)
        idle = self.get_property("idle-active")
        # idle-active None means IPC glitch — treat as still trying to play.
        playing = path is not None and idle is not True
        vol = self.volume()
        return {
            "playing": playing,
            "paused": paused if playing else False,
            "position": position if isinstance(position, (int, float)) else 0,
            "duration": duration if isinstance(duration, (int, float)) else 0,
            "path": path,
            "index": self.index,
            "count": len(self.playlist),
            "volume": vol if vol is not None else load_saved_volume(),
        }


def load_saved_volume() -> int:
    try:
        value = int(VOLUME_FILE.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return 80
    return max(VOLUME_MIN, min(VOLUME_MAX, value))


def draw_chrome(canvas, title, footer):
    fill_rect(canvas, 0, 0, WIDTH, HEIGHT, BLACK)
    title_width = (len(title) * 6 - 1) * 2
    draw_text(canvas, (WIDTH - title_width) // 2, 3, title, GREEN, 2)
    draw_text(canvas, 4, 20, footer, GRAY)
    fill_rect(canvas, 3, 30, WIDTH - 6, 1, DARK_GREEN)


