    rel = "." if cwd == MUSIC_ROOT else str(cwd.relative_to(MUSIC_ROOT))
    draw_chrome(canvas, "MUSIC", "A:OPEN Y/X:TRK START+/SEL-:VOL")
    draw_text(canvas, 8, 34, f"/{rel}"[:48], CYAN)

    rows = []
    if cwd != MUSIC_ROOT:
        rows.append(("..", None))
    for entry in entries:
        rows.append((relative_label(entry, cwd), entry))
    if not rows:
        rows.append(("(EMPTY FOLDER)", None))

    selected = max(0, min(selected, len(rows) - 1))
    visible = 12
    first = max(0, min(selected - visible // 2, len(rows) - visible))
    for row_index, item_index in enumerate(range(first, min(first + visible, len(rows)))):
        y = 48 + row_index * 11
        label, _path = rows[item_index]
        if item_index == selected:
            fill_rect(canvas, 2, y - 2, WIDTH - 4, 10, BLUE)
            color = YELLOW
        else:
            color = WHITE
        draw_text(canvas, 8, y, label[:48], color)

    info = player.status()
    fill_rect(canvas, 3, 196, WIDTH - 6, 1, DARK_GREEN)
    if info["playing"] and info["path"] is not None:
        state = "PAUSE" if info["paused"] else "PLAY"
        draw_text(canvas, 8, 202,
                  f"{state} {info['path'].stem[:22]} VOL{info['volume']:3d}"[:48],
                  GREEN)
        draw_text(canvas, 8, 216,
                  f"{format_time(info['position'])}/{format_time(info['duration'])} "
                  f"{info['index'] + 1}/{info['count']}  B:BACK", GRAY)
        if info["duration"] > 0:
            width = int((WIDTH - 16) * min(1.0, info["position"] / info["duration"]))
            fill_rect(canvas, 8, 230, max(1, width), 4, GREEN)
    else:
        draw_text(canvas, 8, 202, status_text[:48], GRAY)
        draw_text(canvas, 8, 216, "A PLAY  START/SEL VOL  LT/RT SEEK", GRAY)
    present_canvas(framebuffer, canvas)
    return rows, selected


def draw_now_playing(framebuffer, player: MpvPlayer):
    info = player.status()
    canvas = array("I", [BLACK]) * (WIDTH * HEIGHT)
    draw_chrome(canvas, "NOW PLAYING", "A:PAUSE Y/X:TRK LT/RT:SEEK")
    path = info["path"]
    title = path.stem if path else "NO TRACK"
    draw_text(canvas, 16, 56, title[:44], WHITE)
    if path is not None:
        draw_text(canvas, 16, 76, path.suffix.casefold()[1:].upper()[:8], GRAY)
    state = "PAUSED" if info["paused"] else "PLAYING"
    draw_text(canvas, 16, 100, state, YELLOW if info["paused"] else GREEN)
    draw_text(canvas, 16, 124,
              f"{format_time(info['position'])} / {format_time(info['duration'])}",
              WHITE)
    draw_text(canvas, 16, 144, f"TRACK {info['index'] + 1} / {max(1, info['count'])}",
              GRAY)
    vol = info["volume"]
    draw_text(canvas, 16, 160, f"VOLUME {vol:3d}", CYAN)
    fill_rect(canvas, 16, 174, WIDTH - 32, 8, DARK_GREEN)
    fill_rect(canvas, 16, 174,
              max(1, int((WIDTH - 32) * (vol / VOLUME_MAX))), 8, GREEN)
    if info["duration"] > 0:
        fill_rect(canvas, 16, 188, WIDTH - 32, 4, DARK_GREEN)
        width = int((WIDTH - 32) * min(1.0, info["position"] / info["duration"]))
        fill_rect(canvas, 16, 188, max(1, width), 4, YELLOW)
    draw_text(canvas, 8, 206, "B:LIBRARY  SEL:STOP", GRAY)
    draw_text(canvas, 8, 220, "UP/DN: VOLUME +/-", GRAY)
    present_canvas(framebuffer, canvas)


def run():
    device = alsa_device()
    print(f"Music player ALSA device: {device}", file=sys.stderr)
    global MPV_SOCKET, MPV_LOG
    MPV_SOCKET, MPV_LOG = resolve_mpv_paths()
    print(f"mpv IPC path: {MPV_SOCKET}", file=sys.stderr)

    framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
    draw_message(framebuffer, "MUSIC", "LOADING...", f"ALSA {device}"[:48])

    if not shutil_which("mpv"):
        draw_message(framebuffer, "MUSIC", "MPV NOT FOUND",
                     "sudo apt-get install -y mpv")
        time.sleep(2.0)
        os.close(framebuffer)
        return 1

    try:
        ensure_music_root()
    except RuntimeError as error:
        print(error, file=sys.stderr)
        draw_message(framebuffer, "MUSIC", "MUSIC DIR ERROR",
                     "chown /opt/gamepup")
        time.sleep(2.5)
        os.close(framebuffer)
        return 1

    player = MpvPlayer(device)
    input_fd = -1
    cwd = MUSIC_ROOT
    selected = 0
    mode = "browser"
    status = f"DEV {device}"[:48]
    play_grace_until = 0.0

    try:
        input_fd = open_buttons()
        # Parent menu selected this tool with A — ignore that press/release.
        drain_keys(input_fd, settle_s=0.45)

        while running:
            if mode == "now":
                if not player.active():
                    mode = "browser"
                    status = "MPV EXITED"
                    continue
                info = player.status()
                if not info["playing"] and time.monotonic() >= play_grace_until:
                    mode = "browser"
                    status = "PLAYBACK ENDED"
                    continue
                draw_now_playing(framebuffer, player)
                code = wait_key(input_fd, 0.15)
                if code is None:
                    continue
                if code in (KEY_TAB, KEY_1):
                    player.toggle_pause()
                elif code == KEY_5:
                    player.stop_playback()
                    mode = "browser"
                    status = "STOPPED"
                elif code == KEY_LEFT:
                    player.seek(-SEEK_STEP)
                elif code == KEY_RIGHT:
                    player.seek(SEEK_STEP)
                elif code == KEY_UP:
                    player.adjust_volume(VOLUME_STEP)
                elif code == KEY_DOWN:
                    player.adjust_volume(-VOLUME_STEP)
                elif code == KEY_P:
                    player.prev_track()
                elif code == KEY_ESC:
                    player.next_track()
                elif code == KEY_ENTER:
                    mode = "browser"
                    status = "PLAYING IN BACKGROUND"
                continue

            entries = list_entries(cwd)
            rows, selected = draw_browser(
                framebuffer, cwd, entries, selected, player, status)
            code = wait_key(input_fd, 0.2)
            if code is None:
                continue
            if code == KEY_UP:
                selected = (selected - 1) % len(rows)
            elif code == KEY_DOWN:
                selected = (selected + 1) % len(rows)
            elif code == KEY_LEFT:
                if player.active() and player.status()["playing"]:
                    player.seek(-SEEK_STEP)
                elif cwd != MUSIC_ROOT:
                    cwd = cwd.parent
                    selected = 0
            elif code == KEY_RIGHT:
                if player.active() and player.status()["playing"]:
                    player.seek(SEEK_STEP)
            elif code == KEY_P:
                if player.active():
                    player.prev_track()
            elif code == KEY_ESC:
                if player.active():
                    player.next_track()
            elif code == KEY_1:
                if player.active():
                    level = player.adjust_volume(VOLUME_STEP)
                    status = f"VOL {level}"
            elif code == KEY_5:
                if not player.active() or not player.status()["playing"]:
                    continue
                level = player.volume()
                if level is None:
                    level = load_saved_volume()
                if level <= VOLUME_MIN:
                    player.stop_playback()
                    status = "STOPPED"
                else:
                    status = f"VOL {player.adjust_volume(-VOLUME_STEP)}"
            elif code == KEY_ENTER:
                if cwd == MUSIC_ROOT:
                    break
                cwd = cwd.parent
                selected = 0
            elif code == KEY_TAB:
                label, path = rows[selected]
                if label == "..":
                    if cwd != MUSIC_ROOT:
                        cwd = cwd.parent
                        selected = 0
                    continue
                if path is None:
                    continue
                if path.is_dir():
                    cwd = path
                    selected = 0
                    continue
                if is_audio(path):
                    tracks = audio_files_in(path.parent)
                    try:
                        index = tracks.index(path)
                    except ValueError:
                        tracks = [path]
                        index = 0
                    draw_message(framebuffer, "MUSIC", "STARTING MPV...",
                                 path.name[:48])
                    try:
                        if player.play_list(tracks, index):
                            mode = "now"
                            play_grace_until = time.monotonic() + 3.0
                            status = f"PLAY {path.name}"[:48]
                            drain_keys(input_fd, settle_s=0.2)
                        else:
                            status = "PLAY FAILED"
                    except RuntimeError as error:
                        print(error, file=sys.stderr)
                        status = "MPV FAIL — see stderr"[:48]
                        draw_message(framebuffer, "MUSIC", "MPV FAILED",
                                     status)
                        time.sleep(1.2)
    finally:
        player.stop()
        if input_fd >= 0:
            try:
                os.close(input_fd)
            except OSError:
                pass
        try:
            os.close(framebuffer)
        except OSError:
            pass
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        ensure_music_root()
        for path in sorted(MUSIC_ROOT.rglob("*")):
            if is_audio(path):
                print(path)
        return 0
    return run()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, stop_handler)
    signal.signal(signal.SIGTERM, stop_handler)
    raise SystemExit(main())
