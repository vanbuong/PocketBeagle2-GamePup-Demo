#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Create the host-visible FAT32 ROM inbox before it is attached to USB.

set -eu

IMAGE=${GAMEPUP_ROM_IMAGE:-/var/lib/gamepup-rom-drive/gamepup-roms.img}
SIZE_MIB=${GAMEPUP_ROM_SIZE_MIB:-2048}
MOUNTPOINT=/run/gamepup-rom-drive-setup
README_SOURCE=${GAMEPUP_ROM_README:-/usr/local/share/gamepup/rom-drive/README.txt}

if [ "$(id -u)" -ne 0 ]; then
	echo "Run this setup as root." >&2
	exit 1
fi
if [ -e "$IMAGE" ]; then
	exit 0
fi
if ! command -v mkfs.vfat >/dev/null 2>&1; then
	echo "mkfs.vfat is required; install the dosfstools package." >&2
	exit 1
fi

install -d -m 0755 "$(dirname "$IMAGE")" "$MOUNTPOINT"
truncate -s "${SIZE_MIB}M" "$IMAGE"
mkfs.vfat -F 32 -n GAMEPUP "$IMAGE"

mounted=0
cleanup()
{
	if [ "$mounted" -eq 1 ]; then
		umount "$MOUNTPOINT" || true
	fi
}
trap cleanup EXIT HUP INT TERM

mount -o loop,rw,nosuid,nodev,noexec "$IMAGE" "$MOUNTPOINT"
mounted=1
install -d -m 0755 "$MOUNTPOINT/NES" "$MOUNTPOINT/GAME BOY" \
	"$MOUNTPOINT/N64" "$MOUNTPOINT/DOOM" "$MOUNTPOINT/GIFS"
if [ -r "$README_SOURCE" ]; then
	install -m 0644 "$README_SOURCE" "$MOUNTPOINT/README.txt"
fi
sync
umount "$MOUNTPOINT"
mounted=0

echo "Created $IMAGE (${SIZE_MIB} MiB FAT32, label GAMEPUP)."
