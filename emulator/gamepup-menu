def brightness_level() -> int:
    sources = [BRIGHTNESS_FILE]
    path = backlight_path()
    if path is not None:
        sources.append(path)
    for source in sources:
        try:
            return int(source.read_text(encoding="utf-8").strip())
        except (OSError, ValueError):
            pass
    return BRIGHTNESS_LEVELS[-1]


def normalized_brightness_level() -> int:
    level = brightness_level()
    return min(BRIGHTNESS_LEVELS, key=lambda candidate: abs(candidate - level))


def apply_saved_brightness():
    if not BRIGHTNESS_FILE.exists():
        return
    path = backlight_path()
    if path is None:
        return
    try:
        path.write_text(f"{brightness_level()}\n", encoding="utf-8")
    except OSError as error:
        print(f"Unable to restore backlight brightness: {error}", file=sys.stderr)


def adjust_brightness(direction: int) -> bool:
    current = normalized_brightness_level()
    position = BRIGHTNESS_LEVELS.index(current)
    new_position = max(0, min(len(BRIGHTNESS_LEVELS) - 1, position + direction))
    if new_position == position:
        return False
    level = BRIGHTNESS_LEVELS[new_position]
    path = backlight_path()
    if path is None:
        print("No backlight sysfs node found.", file=sys.stderr)
        return False
    try:
        path.write_text(f"{level}\n", encoding="utf-8")
        BRIGHTNESS_FILE.write_text(f"{level}\n", encoding="utf-8")
    except OSError as error:
        print(f"Unable to change backlight brightness: {error}", file=sys.stderr)
        return False
    return True


def game_bezel_style() -> str:
    if GAME_BEZEL_DISABLED_FILE.exists():
        return "OFF"
    try:
        style = GAME_BEZEL_STYLE_FILE.read_text(encoding="utf-8").strip().upper()
    except OSError:
        style = "GAMEPUP"
    if style == "PHOTO":
        style = "SYSTEM"
    return style if style in GAME_BEZEL_STYLES else "GAMEPUP"


def adjust_game_bezel_style(direction: int) -> bool:
    position = GAME_BEZEL_STYLES.index(game_bezel_style())
    style = GAME_BEZEL_STYLES[(position + direction) % len(GAME_BEZEL_STYLES)]
    try:
        GAME_BEZEL_STYLE_FILE.write_text(f"{style}\n", encoding="utf-8")
        GAME_BEZEL_DISABLED_FILE.unlink(missing_ok=True)
    except OSError as error:
        print(f"Unable to change game bezel: {error}", file=sys.stderr)
        return False
    return True


def read_setting_level(path: Path, levels: tuple[int, ...], default: int) -> int:
    try:
        value = int(path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        value = default
    return min(levels, key=lambda candidate: abs(candidate - value))


def oled_brightness_level() -> int:
    return read_setting_level(OLED_BRIGHTNESS_FILE, OLED_BRIGHTNESS_LEVELS, 7)


def oled_refresh_rate() -> int:
    return read_setting_level(OLED_REFRESH_FILE, OLED_REFRESH_LEVELS, 20)


def oled_gifs() -> list[Path]:
    try:
        return sorted((path for path in OLED_GIF_ROOT.iterdir()
                       if path.is_file() and path.suffix.casefold() == ".gif"),
                      key=lambda path: path.name.casefold())
    except OSError:
        return []


def selected_oled_gif() -> Path | None:
    gifs = oled_gifs()
    if not gifs:
        return None
    try:
        selected_name = OLED_GIF_SELECTION_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        selected_name = ""
    return next((path for path in gifs if path.name == selected_name), gifs[0])


def oled_gif_name() -> str:
    selected = selected_oled_gif()
    if selected is None:
        return "NONE"
    return re.sub(r"[-_]+", " ", selected.stem).upper()[:16]


def adjust_oled_gif(direction: int) -> bool:
    gifs = oled_gifs()
    selected = selected_oled_gif()
    if not gifs or selected is None:
        return False
    position = gifs.index(selected)
    new_selected = gifs[(position + direction) % len(gifs)]
    try:
        OLED_GIF_SELECTION_FILE.write_text(new_selected.name + "\n", encoding="utf-8")
    except OSError as error:
        print(f"Unable to select OLED GIF: {error}", file=sys.stderr)
        return False
    return new_selected != selected


def adjust_setting_level(path: Path, levels: tuple[int, ...], current: int,
                         direction: int) -> bool:
    position = levels.index(current)
    new_position = max(0, min(len(levels) - 1, position + direction))
    if new_position == position:
        return False
    try:
        path.write_text(f"{levels[new_position]}\n", encoding="utf-8")
    except OSError as error:
        print(f"Unable to change {path.name}: {error}", file=sys.stderr)
        return False
    return True


def toggle_setting(path: Path):
    try:
        if path.exists():
            path.unlink()
        else:
            path.write_text("1\n", encoding="utf-8")
    except OSError as error:
        print(f"Unable to change {path.name}: {error}", file=sys.stderr)


def claim_display() -> None:
    """Keep Linux fbcon/TTY from painting over the GamePup framebuffer."""
    grant_backlight_access()
    for command in (
        ["sudo", "-n", FBCON, "detach"],
        [FBCON, "detach"],
    ):
        try:
            subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
            return
        except OSError:
            continue


def open_buttons() -> int:
    for path in (INPUT, INPUT_FALLBACK):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        except OSError:
            continue
        try:
            fcntl.ioctl(fd, EVIOCGRAB, 1)
        except OSError as error:
            print(f"Unable to grab {path}: {error}", file=sys.stderr)
        return fd
    raise OSError(f"Unable to open GamePup buttons ({INPUT})")


def run_menu(games: list[Path]) -> int:
    screen = "home"
    import_status_time = modification_time(ROM_IMPORT_STATUS)
    selected = {
        "home": 0,
        "nes": read_selected_index(platform_games(games, "nes")),
        "gbc": read_selected_index(platform_games(games, "gbc")),
        "n64": read_selected_index(platform_games(games, "n64")),
        "benchmarks": 0,
        "tools": 0,
        "settings": 0,
        "second": 0,
        "about": 0,
    }
    claim_display()
    framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
    input_fd = open_buttons()

    try:
        draw_menu(framebuffer, games, screen, selected[screen])
        while running:
            readable, _, _ = select.select([input_fd], [], [], 0.5)
            if not readable:
                new_status_time = modification_time(ROM_IMPORT_STATUS)
                if new_status_time != import_status_time:
                    import_status_time = new_status_time
                    games[:] = installed_games()
                    for platform in ("nes", "gbc", "n64"):
                        count = len(platform_games(games, platform))
                        selected[platform] = min(selected[platform], max(0, count - 1))
                    if screen not in ("about", "import"):
                        draw_menu(framebuffer, games, screen, selected[screen])
                continue
            data = os.read(input_fd, EVENT.size * 32)
            for offset in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _seconds, _micros, event_type, code, value = EVENT.unpack_from(data, offset)
                if event_type != EV_KEY or value != 1:
                    continue
                if screen == "about":
                    if code in (KEY_ENTER, KEY_TAB, KEY_1):
                        play_sound("exit")
                        screen = "settings"
                        draw_menu(framebuffer, games, screen, selected[screen])
                    continue
                if screen == "import":
                    if code in (KEY_TAB, KEY_1):
                        play_sound("select")
                        draw_import_screen(framebuffer, ["IMPORTING", "PLEASE WAIT"])
                        result = import_usb_roms()
                        games[:] = installed_games()
                        draw_import_screen(framebuffer, result)
                    elif code == KEY_ENTER:
                        play_sound("exit")
                        screen = "tools"
                        draw_menu(framebuffer, games, screen, selected[screen])
                    continue
                items = menu_items(games, screen)
                if code == KEY_UP:
                    selected[screen] = (selected[screen] - 1) % len(items)
                    play_sound("up")
                    draw_menu(framebuffer, games, screen, selected[screen])
                elif code == KEY_DOWN:
                    selected[screen] = (selected[screen] + 1) % len(items)
                    play_sound("down")
                    draw_menu(framebuffer, games, screen, selected[screen])
                elif code in (KEY_TAB, KEY_1):
                    if screen == "home":
                        if selected["home"] == 3:
                            game = doom_game(games)
                            if game is None:
                                play_sound("exit")
                                draw_menu(framebuffer, games, screen, selected[screen])
                                continue
                            play_sound("select")
                            os.close(input_fd)
                            os.close(framebuffer)
                            launch(game)
                            if not running:
                                return 0
                            framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                            claim_display()
                            input_fd = open_buttons()
                            wait_for_launch_keys_to_release(input_fd)
                            games[:] = installed_games()
                            screen = "home"
                            draw_menu(framebuffer, games, screen, selected[screen])
                            break
                        target_screen = {0: "nes", 1: "gbc", 2: "n64",
                                         4: "benchmarks", 5: "tools",
                                         6: "settings"}[selected["home"]]
                        if target_screen in ("nes", "gbc", "n64") and not \
                                platform_games(games, target_screen):
                            play_sound("exit")
                            draw_menu(framebuffer, games, screen, selected[screen])
                            continue
                        screen = target_screen
                        play_sound("select")
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen in ("nes", "gbc", "n64"):
                        game_list = platform_games(games, screen)
                        game = game_list[selected[screen]]
                        play_sound("select")
                        os.close(input_fd)
                        os.close(framebuffer)
                        launch(game)
                        if not running:
                            return 0
                        framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                        claim_display()
                        input_fd = open_buttons()
                        wait_for_launch_keys_to_release(input_fd)
                        games[:] = installed_games()
                        selected[screen] = read_selected_index(platform_games(games, screen))
                        draw_menu(framebuffer, games, screen, selected[screen])
                        break
                    elif screen == "benchmarks":
                        benchmark_index = selected["benchmarks"]
                        if benchmark_index == len(GPU_BENCHMARKS):
                            play_sound("exit")
                            screen = "home"
                            draw_menu(framebuffer, games, screen, selected[screen])
                            continue
                        play_sound("select")
                        os.close(input_fd)
                        os.close(framebuffer)
                        launch_gpu_benchmark(GPU_BENCHMARKS[benchmark_index][1])
                        if not running:
                            return 0
                        framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                        claim_display()
                        input_fd = open_buttons()
                        wait_for_launch_keys_to_release(input_fd)
                        draw_menu(framebuffer, games, screen, selected[screen])
                        break
                    elif screen == "tools":
                        tool_index = selected["tools"]
                        if tool_index == 0:
                            play_sound("select")
                            screen = "import"
                            draw_import_screen(framebuffer)
                        elif tool_index == 1:
                            play_sound("select")
                            os.close(input_fd)
                            os.close(framebuffer)
                            launch_voice_memo()
                            if not running:
                                return 0
                            framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                            claim_display()
                            input_fd = open_buttons()
                            wait_for_launch_keys_to_release(input_fd)
                            draw_menu(framebuffer, games, screen, selected[screen])
                            break
                        elif tool_index == 2:
                            play_sound("select")
                            os.close(input_fd)
                            os.close(framebuffer)
                            launch_music_player()
                            if not running:
                                return 0
                            framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                            claim_display()
                            input_fd = open_buttons()
                            wait_for_launch_keys_to_release(input_fd)
                            draw_menu(framebuffer, games, screen, selected[screen])
                            break
                        elif tool_index == 3:
                            play_sound("select")
                            os.close(input_fd)
                            os.close(framebuffer)
                            launch_hardware_test()
                            if not running:
                                return 0
                            framebuffer = os.open(FRAMEBUFFER, os.O_RDWR | os.O_CLOEXEC)
                            claim_display()
                            input_fd = open_buttons()
                            wait_for_launch_keys_to_release(input_fd)
                            draw_menu(framebuffer, games, screen, selected[screen])
                            break
                        else:
                            play_sound("exit")
                            screen = "home"
                            draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "settings":
                        if selected["settings"] == 0:
                            toggle_mute()
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 1:
                            toggle_menu_beeps()
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 2:
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 3:
                            adjust_game_bezel_style(1)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 4:
                            play_sound("select")
                            screen = "second"
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 5:
                            play_sound("select")
                            screen = "about"
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["settings"] == 6:
                            play_sound("exit")
                            return 0
                        else:
                            play_sound("exit")
                            screen = "home"
                            draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "second":
                        if selected["second"] == 0:
                            toggle_setting(OLED_DISABLED_FILE)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] in (1, 2):
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] == 3:
                            toggle_setting(OLED_GIF_MODE_FILE)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] == 4:
                            adjust_oled_gif(1)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] == 5:
                            toggle_setting(OLED_CLOCK_HIDDEN_FILE)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] == 6:
                            toggle_setting(OLED_PER_CORE_FILE)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        elif selected["second"] == 7:
                            toggle_setting(OLED_GPU_HIDDEN_FILE)
                            draw_menu(framebuffer, games, screen, selected[screen])
                        else:
                            play_sound("exit")
                            screen = "settings"
                            draw_menu(framebuffer, games, screen, selected[screen])
                elif code in (KEY_LEFT, KEY_RIGHT):
                    direction = -1 if code == KEY_LEFT else 1
                    if screen == "settings" and selected["settings"] == 2:
                        if adjust_brightness(direction):
                            play_sound("down" if direction < 0 else "up")
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "settings" and selected["settings"] == 3:
                        if adjust_game_bezel_style(direction):
                            play_sound("down" if direction < 0 else "up")
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "second" and selected["second"] == 1:
                        if adjust_setting_level(OLED_BRIGHTNESS_FILE,
                                                OLED_BRIGHTNESS_LEVELS,
                                                oled_brightness_level(), direction):
                            play_sound("down" if direction < 0 else "up")
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "second" and selected["second"] == 2:
                        if adjust_setting_level(OLED_REFRESH_FILE, OLED_REFRESH_LEVELS,
                                                oled_refresh_rate(), direction):
                            play_sound("down" if direction < 0 else "up")
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen == "second" and selected["second"] == 4:
                        if adjust_oled_gif(direction):
                            play_sound("down" if direction < 0 else "up")
                        draw_menu(framebuffer, games, screen, selected[screen])
                elif code == KEY_ENTER:
                    if screen == "second":
                        play_sound("exit")
                        screen = "settings"
                        draw_menu(framebuffer, games, screen, selected[screen])
                    elif screen != "home":
                        play_sound("exit")
                        screen = "home"
                        draw_menu(framebuffer, games, screen, selected[screen])
    finally:
        try:
            os.close(input_fd)
        except OSError:
            pass
        try:
            os.close(framebuffer)
        except OSError:
            pass
    return 0


def main() -> int:
    games = installed_games()
    if len(sys.argv) > 1 and sys.argv[1] == "--list":
        for game in games:
            print(f"{game.suffix[1:].upper():3}  {clean_name(game)}")
        return 0
    if not games:
        print(f"No games found under {GAME_ROOT}", file=sys.stderr)
        return 1
    try:
        FPS_FILE.unlink(missing_ok=True)
    except OSError:
        pass
    apply_saved_brightness()
    return run_menu(games)


if __name__ == "__main__":
    signal.signal(signal.SIGINT, stop_handler)
    signal.signal(signal.SIGTERM, stop_handler)
    raise SystemExit(main())
