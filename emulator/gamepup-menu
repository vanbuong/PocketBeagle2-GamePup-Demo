            f"GAME BOY {len(platform_games(games, 'gbc'))} >",
            f"N64 GAMES {len(platform_games(games, 'n64'))} >",
            "DOOM" if doom_game(games) else "DOOM MISSING",
            "BENCHMARKS >",
            "TOOLS >",
            "SETTINGS >",
        ]
    if screen in ("nes", "gbc", "n64"):
        return [clean_name(game) for game in platform_games(games, screen)]
    if screen == "settings":
        return [
            "ALL SOUND MUTED" if MUTE_FILE.exists() else "ALL SOUND ON",
            "MENU BEEPS OFF" if MENU_MUTE_FILE.exists() else "MENU BEEPS ON",
            "BRIGHTNESS",
            f"BEZEL {game_bezel_style()}",
            "SECOND SCREEN >",
            "ABOUT >",
            "EXIT TO TTY",
            "BACK",
        ]
    if screen == "benchmarks":
        return [label for label, _argument in GPU_BENCHMARKS] + ["BACK"]
    if screen == "tools":
        return ["IMPORT USB ROMS >", "VOICE MEMO", "MUSIC PLAYER", "HARDWARE TEST", "BACK"]
    if screen == "second":
        return [
            "DISPLAY OFF" if OLED_DISABLED_FILE.exists() else "DISPLAY ON",
            "BRIGHTNESS",
            f"REFRESH {oled_refresh_rate()}HZ",
            "MODE GIF" if OLED_GIF_MODE_FILE.exists() else "MODE STATUS",
            f"GIF {oled_gif_name()}",
