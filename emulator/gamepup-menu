def clean_name(path: Path) -> str:
    name = path.stem.replace("_", " ")
    name = re.sub(r"\s*(?:\([^)]*\)|\[[^]]*\])", "", name)
    return re.sub(r"\s+", " ", name).strip()


def installed_games() -> list[Path]:
    games = [path for path in GAME_ROOT.rglob("*")
             if path.is_file() and path.suffix.casefold() in CORES]
    return sorted(games, key=lambda path: clean_name(path).casefold())


def fill_rect(canvas: array, x: int, y: int, width: int, height: int, color: int):
    x0, y0 = max(0, x), max(0, y)
    x1, y1 = min(WIDTH, x + width), min(HEIGHT, y + height)
    row = array("I", [color]) * max(0, x1 - x0)
    for target_y in range(y0, y1):
        canvas[target_y * WIDTH + x0:target_y * WIDTH + x1] = row


def draw_text(canvas: array, x: int, y: int, text: str, color: int, scale: int = 1):
    cursor = x
    for character in text.upper():
        glyph = FONT.get(character, FONT["?"])
        for glyph_y, bits in enumerate(glyph):
            for glyph_x, bit in enumerate(bits):
                if bit == "1":
                    fill_rect(canvas, cursor + glyph_x * scale, y + glyph_y * scale,
                              scale, scale, color)
        cursor += 6 * scale


def platform_games(games: list[Path], screen: str) -> list[Path]:
    if screen == "nes":
        return [game for game in games if game.suffix.casefold() == ".nes"]
    if screen == "gbc":
        return [game for game in games if game.suffix.casefold() in (".gb", ".gbc")]
    if screen == "n64":
        return [game for game in games
                if game.suffix.casefold() in (".z64", ".n64", ".v64")]
    if screen == "doom":
        return [game for game in games if game.suffix.casefold() == ".wad"]
    return []


def doom_game(games: list[Path]):
    doom_games = platform_games(games, "doom")
    for game in doom_games:
        if game.name.casefold() == "doom shareware.wad":
            return game
    return doom_games[0] if doom_games else None


