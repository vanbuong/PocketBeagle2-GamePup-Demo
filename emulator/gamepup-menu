def import_usb_roms() -> list[str]:
    try:
        completed = subprocess.run(
            [ROM_IMPORT, "-n", ROM_IMPORT_HELPER], check=False,
            capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as error:
        return ["IMPORT FAILED", str(error).upper()[:48]]

    values = {}
    for line in completed.stdout.splitlines():
        key, _, value = line.partition(" ")
        values[key] = value.strip()
    if values.get("RESULT") != "OK":
        return ["IMPORT FAILED", values.get("MESSAGE", "CHECK USB DRIVE")[:48]]
    return [
        f"ADDED {values.get('IMPORTED', '0')}",
        f"UPDATED {values.get('REPLACED', '0')}",
        f"UNCHANGED {values.get('UNCHANGED', '0')}",
        f"REJECTED {values.get('REJECTED', '0')}",
    ]


