def backlight_path() -> Path | None:
    global _backlight_path
    if _backlight_path is not None:
        return _backlight_path if _backlight_path.parts else None
    for candidate in BACKLIGHT_CANDIDATES:
        if candidate.exists():
            _backlight_path = candidate
            return candidate
    root = Path("/sys/class/backlight")
    if root.is_dir():
        for directory in sorted(root.iterdir()):
            candidate = directory / "brightness"
            if candidate.exists():
                _backlight_path = candidate
                return candidate
    _backlight_path = Path()
    return None


def grant_backlight_access() -> None:
    for command in (
        ["sudo", "-n", BACKLIGHT_PERMISSIONS, "grant"],
        [BACKLIGHT_PERMISSIONS, "grant"],
    ):
        try:
            subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
            return
        except OSError:
            continue


def read_fb_info(framebuffer: int) -> dict:
    global _fb_info
    if _fb_info is not None:
        return _fb_info
    # struct fb_var_screeninfo: first two u32 are xres, yres; bits_per_pixel at offset 24
    var = array("B", [0]) * 160
    fix = array("B", [0]) * 128
    fcntl.ioctl(framebuffer, FBIOGET_VSCREENINFO, var, True)
    fcntl.ioctl(framebuffer, FBIOGET_FSCREENINFO, fix, True)
    xres = int.from_bytes(var[0:4], "little")
    yres = int.from_bytes(var[4:8], "little")
    bpp = int.from_bytes(var[24:28], "little")
    # line_length is at offset 48 in fb_fix_screeninfo on 64-bit (after id[16], smem_start)
    # Portable approach: read sysfs when available.
    stride = 0
    try:
        stride = int(Path("/sys/class/graphics/fb0/stride").read_text().strip())
    except (OSError, ValueError):
        stride = xres * (bpp // 8)
    if bpp not in (16, 32):
        raise OSError(f"Expected 16- or 32-bit framebuffer, got {bpp} bpp")
    if (xres, yres) not in ((WIDTH, HEIGHT), (HEIGHT, WIDTH)):
        raise OSError(f"Unsupported framebuffer {xres}x{yres}")
    _fb_info = {"width": xres, "height": yres, "stride": stride, "bpp": bpp}
    print(f"GamePup framebuffer {xres}x{yres} stride={stride} bpp={bpp}", file=sys.stderr)
    return _fb_info


def present_canvas(framebuffer, canvas):
    info = read_fb_info(framebuffer)
    stride = info["stride"]
    height = info["height"]
    width = info["width"]
    bpp = info["bpp"]
    frame = bytearray(stride * height)

    def put_pixel(dst_x, dst_y, color):
        if bpp == 16:
            red = (color >> 16) & 0xff
            green = (color >> 8) & 0xff
            blue = color & 0xff
            value = ((red >> 3) << 11) | ((green >> 2) << 5) | (blue >> 3)
            offset = dst_y * stride + dst_x * 2
            frame[offset:offset + 2] = int(value).to_bytes(2, "little")
        else:
            offset = dst_y * stride + dst_x * 4
            frame[offset:offset + 4] = int(color).to_bytes(4, "little")

    if width == WIDTH and height == HEIGHT:
        src = memoryview(canvas)
        for y in range(HEIGHT):
            for x in range(WIDTH):
                put_pixel(x, y, int(src[y * WIDTH + x]))
    else:
        src = memoryview(canvas)
        for y in range(HEIGHT):
            for x in range(WIDTH):
                put_pixel(y, WIDTH - 1 - x, int(src[y * WIDTH + x]))
    view = memoryview(frame)
    written = 0
    while written < len(frame):
        written += os.pwrite(framebuffer, view[written:], written)


