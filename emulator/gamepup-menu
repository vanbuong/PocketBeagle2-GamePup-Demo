def resolve_buzzer_path():
    for candidate in BUZZER_CANDIDATES:
        if os.path.exists(candidate):
            return candidate
    by_path = Path("/dev/input/by-path")
    if by_path.is_dir():
        for pattern in ("*buzzer*", "*pwm-beeper*", "*pwm_beeper*"):
            matches = sorted(by_path.glob(pattern))
            if matches:
                return str(matches[0])
    for name_path in Path("/sys/class/input").glob("event*/device/name"):
        try:
            name = name_path.read_text(encoding="ascii").strip()
        except OSError:
            continue
        lowered = name.casefold()
        if name in ("gamepup-buzzer", "pwm-beeper") or "buzzer" in lowered \
                or "beeper" in lowered:
            return f"/dev/input/{name_path.parent.parent.name}"
    return None


def silence_buzzer():
    path = resolve_buzzer_path()
    if not path:
        return
    try:
        buzzer_fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        os.write(buzzer_fd, EVENT.pack(0, 0, 0x12, 2, 0))
        os.close(buzzer_fd)
    except OSError:
        pass


def play_sound(name: str):
    if MUTE_FILE.exists() or MENU_MUTE_FILE.exists():
        return
    path = resolve_buzzer_path()
    if not path:
        print("PWM buzzer input device not found "
              "(check gamepup-buzzer / epwm2 overlay)", file=sys.stderr)
        return
    sounds = {
        "up": ((660, 0.022), (880, 0.032)),
        "down": ((880, 0.022), (660, 0.032)),
        "select": ((988, 0.035), (1319, 0.055)),
        "exit": ((988, 0.035), (659, 0.065)),
        "unmute": ((659, 0.025), (988, 0.045)),
    }
    buzzer_fd = -1
    try:
        buzzer_fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        for frequency, duration in sounds[name]:
            os.write(buzzer_fd, EVENT.pack(0, 0, 0x12, 2, frequency))
            time.sleep(duration)
        os.write(buzzer_fd, EVENT.pack(0, 0, 0x12, 2, 0))
    except (KeyError, OSError) as error:
        print(f"Buzzer write failed on {path}: {error}", file=sys.stderr)
        silence_buzzer()
    finally:
        if buzzer_fd >= 0:
            os.close(buzzer_fd)


def toggle_mute():
    if MUTE_FILE.exists():
        MUTE_FILE.unlink()
        play_sound("unmute")
    else:
        MUTE_FILE.write_text("muted\n", encoding="utf-8")
