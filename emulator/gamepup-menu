            "CPU PER CORE" if OLED_PER_CORE_FILE.exists() else "CPU TOTAL",
            "GPU STATUS OFF" if OLED_GPU_HIDDEN_FILE.exists() else "GPU STATUS ON",
            "BACK",
        ]
    return []


def draw_menu(framebuffer: int, games: list[Path], screen: str, selected: int):
    canvas = array("I", [BLACK]) * (WIDTH * HEIGHT)
    titles = {"home": "GAMEPUP", "nes": "NES GAMES", "gbc": "GAME BOY",
              "n64": "N64 GAMES",
              "benchmarks": "BENCHMARKS", "tools": "TOOLS",
              "settings": "SETTINGS", "second": "2ND SCREEN", "about": "ABOUT"}
    title = titles[screen]
    title_width = (len(title) * 6 - 1) * 2
    draw_text(canvas, (WIDTH - title_width) // 2, 3, title, GREEN, 2)
    draw_text(canvas, 4, 20, "B:BACK" if screen == "about" else
              "UP/DN A:OPEN B:BACK", GRAY)
    fill_rect(canvas, 3, 30, WIDTH - 6, 1, DARK_GREEN)

    if screen == "about":
        draw_text(canvas, 16, 48, "VERSION", GRAY)
        draw_text(canvas, 100, 48, MENU_VERSION, YELLOW)
        draw_text(canvas, 16, 78, "SYSTEM", GRAY)
        draw_text(canvas, 16, 92, "POCKETBEAGLE 2", WHITE)
        draw_text(canvas, 16, 106, "ARMBIAN LINUX", WHITE)
        draw_text(canvas, 16, 136, "DISPLAY", GRAY)
        draw_text(canvas, 16, 150, "ILI9341 320X240", WHITE)
        draw_text(canvas, 16, 178, "GITHUB", GRAY)
        draw_text(canvas, 16, 192, "@GRIPPY98", GREEN)
        fill_rect(canvas, 3, 224, WIDTH - 6, 1, DARK_GREEN)
        draw_text(canvas, 8, 228, "B:BACK", GRAY)
        present_canvas(framebuffer, canvas)
        return

    items = menu_items(games, screen)
    visible = 16
    first = max(0, min(selected - visible // 2, len(items) - visible))
    for row_index, item_index in enumerate(range(first, min(first + visible, len(items)))):
        y = 38 + row_index * 11
        if item_index == selected:
            fill_rect(canvas, 2, y - 2, WIDTH - 4, 10, BLUE)
            color = YELLOW
        else:
            color = WHITE
        draw_text(canvas, 8, y, items[item_index][:48], color)
        slider = None
        if screen == "settings" and item_index == 2:
            slider = (200, 96, BRIGHTNESS_LEVELS,
                      BRIGHTNESS_LEVELS.index(normalized_brightness_level()))
        elif screen == "second" and item_index == 1:
            slider = (200, 96, OLED_BRIGHTNESS_LEVELS,
                      OLED_BRIGHTNESS_LEVELS.index(oled_brightness_level()))
        elif screen == "second" and item_index == 2:
            slider = (220, 72, OLED_REFRESH_LEVELS,
                      OLED_REFRESH_LEVELS.index(oled_refresh_rate()))
        if slider:
            slider_x, slider_width, levels, position = slider
            knob_x = slider_x + (slider_width - 3) * position // (len(levels) - 1)
            fill_rect(canvas, slider_x, y + 3, slider_width, 1, GRAY)
            fill_rect(canvas, slider_x, y + 3, knob_x - slider_x + 1, 1, color)
            fill_rect(canvas, knob_x, y, 3, 7, color)

    page = f"{selected + 1}/{len(items)}"
    fill_rect(canvas, 3, 224, WIDTH - 6, 1, DARK_GREEN)
    if screen == "home":
        muted = MUTE_FILE.exists()
        footer = "SOUND:MUTED" if muted else "SOUND:ON"
        footer_color = RED if muted else GREEN
    elif screen == "settings":
        if selected == 2:
            footer = "LT/RT:ADJUST"
        elif selected == 3:
            footer = "LT/RT:STYLE"
        else:
            footer = "A:CHANGE"
        footer_color = GRAY
    elif screen == "second":
        footer = "LT/RT:ADJUST" if selected in (1, 2, 4) else "A:CHANGE"
        footer_color = GRAY
    else:
        footer, footer_color = "B:BACK", GRAY
    draw_text(canvas, 8, 228, footer, footer_color)
    draw_text(canvas, WIDTH - len(page) * 6 - 6, 228, page, YELLOW)
    present_canvas(framebuffer, canvas)


def read_selected_index(games: list[Path]) -> int:
    try:
        selected_path = Path(SELECTION_FILE.read_text(encoding="utf-8").strip())
        return games.index(selected_path)
    except (OSError, ValueError):
        return 0


def modification_time(path: Path) -> int:
    try:
        return path.stat().st_mtime_ns
    except OSError:
        return 0


def keys_down(input_fd: int, keys: tuple[int, ...]) -> bool:
    key_bits = bytearray(96)
    eviocgkey = (2 << 30) | (len(key_bits) << 16) | (ord("E") << 8) | 0x18
    fcntl.ioctl(input_fd, eviocgkey, key_bits, True)
    return any(key_bits[key // 8] & (1 << (key % 8)) for key in keys)


def wait_for_launch_keys_to_release(input_fd: int):
    deadline = time.monotonic() + 3.0
    while time.monotonic() < deadline and keys_down(input_fd, (KEY_1, KEY_5, KEY_TAB)):
        time.sleep(0.05)
    try:
        while os.read(input_fd, EVENT.size * 32):
            pass
    except BlockingIOError:
        pass


def launch(game: Path):
    SELECTION_FILE.write_text(str(game) + "\n", encoding="utf-8")
    try:
        subprocess.run([FRONTEND, str(game), CORES[game.suffix.casefold()]], check=False)
    finally:
        silence_buzzer()
    if running:
        play_sound("exit")


